# Copy to .env and fill in local values. Never commit .env or real passwords.
# Spring Boot does not load .env automatically — export the variables in your
# shell, IDE run configuration, or pass them when starting the process.
#
# Example (bash):
#   set -a && source .env && set +a
#   ./mvnw spring-boot:run
#
# Docker Compose (from repo root):
#   docker compose --env-file .env -f backend-boleto-batch-service/docker-compose.yml up -d

# --- backend-authentication-boleto (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/bd_authentication_boleto
DB_USERNAME=postgres
DB_PASSWORD=

# --- both backends (RabbitMQ) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=
