# Basta copiar para .env e rodar: os valores abaixo sao APENAS DEMO LOCAL, troque em producao. Nunca commite o .env.
#
# Docker (recomendado), na raiz do repo:
#   docker compose up --build
#
# Rodando local sem Docker: o Spring Boot nao le o .env sozinho.
# Exporte as variaveis no shell ou na run configuration da IDE.

# --- PostgreSQL (backend-authentication-boleto) ---
POSTGRES_DB=bd_authentication_boleto
DB_URL=jdbc:postgresql://localhost:5432/bd_authentication_boleto
DB_USERNAME=postgres
# apenas demo local, troque em producao
DB_PASSWORD=authboleto_demo

# --- RabbitMQ (os dois backends) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
# apenas demo local, troque em producao
RABBITMQ_PASSWORD=rabbit_demo

# --- JWT (backend-authentication-boleto) ---
# apenas demo local, troque em producao
JWT_SECRET=demo-local-jwt-secret-troque-em-producao-0123456789
JWT_EXPIRATION_MS=3600000

# --- batch -> auth (no Docker o compose ja aponta para http://auth-service:8080/api/boleto) ---
BOLETO_SERVICE_URL=http://localhost:8080/api/boleto

# E-mail (no Docker o compose já aponta para o Mailpit)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@authboleto.local
MAIL_DEFAULT_TO=demo@authboleto.local
